{
  "name": "@jamaalbuilds/aitk",
  "version": "0.1.0",
  "description": "CLI for scaffolding full-stack AI projects. One command, complete stack.",
  "author": "Danilo Batson <djbatson19@gmail.com>",
  "license": "MIT",
  "type": "module",
  "bin": {
    "aitk": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "biome check --error-on-warnings src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "chalk": "5.6.2",
    "commander": "13.1.0",
    "ora": "8.2.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "keywords": [
    "cli",
    "ai",
    "toolkit",
    "scaffolding",
    "fullstack",
    "mcp",
    "rag",
    "agents",
    "fastapi",
    "nextjs",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/danilobatson/ai-toolkit",
    "directory": "packages/cli"
  }
}
